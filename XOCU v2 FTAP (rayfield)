local function applyAll(beam)
    if not beam then return end
    pcall(function()
        if currentTex ~= "rbxassetid://0" then beam.Texture = currentTex end
        beam.TextureLength  = TrailProps.TextureLength
        beam.TextureSpeed   = TrailProps.TextureSpeed
        beam.Width0         = TrailProps.Width0
        beam.Width1         = TrailProps.Width1
        beam.CurveSize0     = TrailProps.CurveSize0
        beam.CurveSize1     = TrailProps.CurveSize1
        beam.Segments       = TrailProps.Segments
        beam.LightEmission  = TrailProps.LightEmission
        beam.LightInfluence = TrailProps.LightInfluence
        beam.Transparency   = NumberSequence.new(TrailProps.Transparency)
        beam.ZOffset        = TrailProps.ZOffset
    end)
end

local function applyProp(prop, val)
    TrailProps[prop] = val
    local beam = getBeam() or currentBeam
    if not beam then return end
    pcall(function()
        if prop == "Transparency" then beam.Transparency = NumberSequence.new(val)
        else beam[prop] = val end
    end)
end

local function connectBeam(beam)
    if not beam then return end
    if beamConn then beamConn:Disconnect() end
    beamConn = beam.AncestryChanged:Connect(function(_, parent)
        if not parent then currentBeam = nil end
    end)
    currentBeam = beam
    applyAll(beam)
end

