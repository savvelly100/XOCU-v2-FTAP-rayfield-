    CurrentOption = {"Both"},
    Flag = "CosStyle",
    Callback = function(v)
        CosmeticChoice = v[1]
        if FakeCosmeticsEnabled then StripCosmetics(); ApplyCosmetics() end
    end
})
CosmTab:CreateToggle({
    Name = "Re-apply on Respawn",
    CurrentValue = false, Flag = "CosRespawn",
    Callback = function(v) RespawnPersist = v end
})
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    SaveHeadData = nil
    if FakeCosmeticsEnabled and RespawnPersist then ApplyCosmetics() end
end)

