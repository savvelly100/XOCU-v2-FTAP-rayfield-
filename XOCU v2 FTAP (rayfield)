tbl17.removesticky = function(model)
    if typeof(model) ~= "Instance" or not model:IsA("Model") or not model.Parent then return false end
    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not hrp or not hrp:IsA("BasePart") then return false end
    local plotItems = Workspace:FindFirstChild("PlotItems")
    local seen = setmetatable({}, { __mode = "k" })
    local function reg(m)
        if typeof(m) ~= "Instance" then return end
        local p = m:IsA("BasePart") and m.Parent or m
        if p and p:IsA("Model") and p ~= model and p.Parent then seen[p] = true end
    end
    for _, d in pairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            for _, c in pairs(d:GetConnectedParts()) do
                if c.Name == "StickyPart" then
                    for _, ch in pairs(c:GetChildren()) do
                        if ch:IsA("TouchInterest") then ch:Destroy() end
                    end
                    reg(c)
                end
            end
        end
    end
    local plr = Players:GetPlayerFromCharacter(model)
    if plr then
        local inv, plot = tbl17.getInventory(plr)
        if inv then for _, ch in pairs(inv:GetChildren()) do reg(ch) end end
        if plot then for _, ch in pairs(plot:GetChildren()) do reg(ch) end end
    end
    local any = false
    for m in pairs(seen) do
        if m.Parent then
            local ok, piv = pcall(m.GetPivot, m)
            if ok and (piv.Position - hrp.Position).Magnitude <= 10 then
                local nice = tbl17.findNicePart(m)
                if nice and nice:IsA("BasePart") then
                    local bv = nice:FindFirstChild("RscBV")
                    if bv and not bv:IsA("BodyVelocity") then bv:Destroy() bv = nil end
                    if not bv then
                        local nv = Instance.new("BodyVelocity")
                        nv.Velocity = Vector3.new(0,-50000,0)
                        nv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
                        nv.Name = "RscBV"; nv.Parent = nice
                    end
                    tbl17.ToggleCollisions(m, false)
                    if not (plotItems and m:IsDescendantOf(plotItems)) then tbl17.grab(nice) end
                    local sp = m:FindFirstChild("StickyPart")
                    if sp then for _, ch in pairs(sp:GetChildren()) do ch:Destroy() end end
                    m:PivotTo(CFrame.new(0,-50000,0))
                    task.delay(1, tbl17.unsno, nice)
                    any = true
                end
            end
        end
    end
    return any
end

