local CosmTab = Window:CreateTab("Cosmetics", 4483345998)

local SaveHeadData, FakeCosmeticsEnabled, RespawnPersist, CosmeticChoice = nil, false, false, "Both"
local KORBLOX_MESH, KORBLOX_TEX = "101851696", "101851254"
local HEADLESS_MESH, HEADLESS_TEX = "134082579", "134082627"

local function SnapshotHead()
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    SaveHeadData = { T = head.Transparency, C = head.BrickColor, M = head.Material, Meshes = {}, Decals = {} }
    for _, o in ipairs(head:GetChildren()) do
        if o:IsA("SpecialMesh") then
            table.insert(SaveHeadData.Meshes, {MT=o.MeshType, MI=o.MeshId, TI=o.TextureId, S=o.Scale, O=o.Offset, V=o.VertexColor, N=o.Name})
        elseif o:IsA("Decal") then
            table.insert(SaveHeadData.Decals, {T=o.Texture, F=o.Face, Tr=o.Transparency, N=o.Name})
        end
    end
end

local function WearHeadless()
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    SnapshotHead()
    for _, o in ipairs(head:GetChildren()) do
        if o:IsA("Decal") or o:IsA("SpecialMesh") then o:Destroy() end
    end
    local m = Instance.new("SpecialMesh")
    m.MeshType = Enum.MeshType.FileMesh
    m.MeshId = "rbxassetid://" .. HEADLESS_MESH
    m.TextureId = "rbxassetid://" .. HEADLESS_TEX
    m.Scale = Vector3.new(1.25, 1.25, 1.25)
    m.Name = "XOCU_HeadlessMesh"
    m.Parent = head
    head.Transparency = 0.1
    head.BrickColor = BrickColor.new("Really black")
    head.Material = Enum.Material.Plastic
end

local function WearKorblox()
    local char = LocalPlayer.Character
    local rleg = char and (char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg"))
    if not rleg then return end
    local old = char:FindFirstChild("XOCU_KorbloxLeg")
    if old then old:Destroy() end
    local fake = Instance.new("Part")
    fake.Name = "XOCU_KorbloxLeg"
    fake.Size = rleg.Size
    fake.CFrame = rleg.CFrame
    fake.Anchored = false
    fake.CanCollide = false
    fake.Transparency = 0
    fake.BrickColor = BrickColor.new("Really black")
    fake.Material = Enum.Material.Plastic
    fake.Parent = char
    local m = Instance.new("SpecialMesh")
    m.MeshType = Enum.MeshType.FileMesh
    m.MeshId = "rbxassetid://" .. KORBLOX_MESH
    m.TextureId = "rbxassetid://" .. KORBLOX_TEX
    m.Parent = fake
    local w = Instance.new("WeldConstraint")
    w.Part0 = rleg; w.Part1 = fake
    w.Parent = rleg
    rleg.Transparency = 1
end

local function StripCosmetics()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then
        local m = head:FindFirstChild("XOCU_HeadlessMesh")
        if m then m:Destroy() end
        if SaveHeadData then
            head.Transparency = SaveHeadData.T
            head.BrickColor = SaveHeadData.C
            head.Material = SaveHeadData.M
            for _, d in ipairs(SaveHeadData.Meshes) do
                local mesh = Instance.new("SpecialMesh")
                mesh.MeshType = d.MT; mesh.MeshId = d.MI
                mesh.TextureId = d.TI; mesh.Scale = d.S
                mesh.Offset = d.O; mesh.VertexColor = d.V; mesh.Name = d.N
                mesh.Parent = head
            end
            for _, d in ipairs(SaveHeadData.Decals) do
                local dec = Instance.new("Decal")
                dec.Texture = d.T; dec.Face = d.F
                dec.Transparency = d.Tr; dec.Name = d.N
                dec.Parent = head
            end
            SaveHeadData = nil
        else
            head.Transparency = 0
        end
    end
    local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
    if rleg then rleg.Transparency = 0 end
    local fake = char:FindFirstChild("XOCU_KorbloxLeg")
    if fake then fake:Destroy() end
end

local function ApplyCosmetics()
    if CosmeticChoice == "Headless" then WearHeadless()
    elseif CosmeticChoice == "Korblox" then WearKorblox()
    elseif CosmeticChoice == "Both" then WearHeadless(); WearKorblox() end
end

CosmTab:CreateToggle({
    Name = "Enable Cosmetics",
    CurrentValue = false, Flag = "FakeCos",
    Callback = function(v)
        FakeCosmeticsEnabled = v
        if v then ApplyCosmetics() else StripCosmetics() end
    end
})
CosmTab:CreateDropdown({
