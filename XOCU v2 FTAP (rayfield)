do
    local tracked = {}
    local conn
    local function app(p, state)
        if not p:IsA("BasePart") or p.Name ~= "PaintPlayerPart" then return end
        p.CanTouch = not state
        if state and not tracked[p] then
            tracked[p] = p:GetPropertyChangedSignal("CanTouch"):Connect(function()
                if tbl19.AntiPaint and p.Parent then p.CanTouch = false end
            end)
        end
    end
    local function apply(state)
        for k, c in pairs(tracked) do
            c:Disconnect(); tracked[k] = nil
            if k.Parent then k.CanTouch = true end
        end
        if conn then conn:Disconnect(); conn = nil end
        for _, d in ipairs(Workspace:GetDescendants()) do app(d, state) end
        if state then conn = Workspace.DescendantAdded:Connect(function(d) app(d, true) end) end
    end
    _G._applyAntiPaint = apply
end

