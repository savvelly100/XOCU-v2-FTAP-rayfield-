                        if hum.Parent and hum.Health > 0 and not isHeld.Value
                            and not hum:FindFirstChild("Ragdolled").Value
                            and (seat.Occupant == nil or seat.Occupant == hum)
                            and tbl19.GucciAntiGrab and tbl18.GucciType == gType
                            and myCounter == gucciCounter then
