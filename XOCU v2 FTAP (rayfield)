local function locateRemoteRoot()
    local function isRR(arg)
        return arg and arg:FindFirstChild("GrabEvents") and arg:FindFirstChild("MenuToys") and arg:FindFirstChild("CharacterEvents")
    end
    if isRR(replicatedStorage) then return replicatedStorage end
    for _, d in ipairs(replicatedStorage:GetDescendants()) do
        if isRR(d) then return d end
    end
    return replicatedStorage
end

refreshRemotes = function()
    v21 = locateRemoteRoot()
    local grabEvents2     = replicatedStorage:FindFirstChild("GrabEvents")
    local menuToys        = v21 and v21:FindFirstChild("MenuToys")
    local characterEvents = v21 and v21:FindFirstChild("CharacterEvents")
    local playerEvents    = v21 and v21:FindFirstChild("PlayerEvents")
    tbl23.sno             = grabEvents2 and grabEvents2:FindFirstChild("SetNetworkOwner") or nil
    tbl23.cgl             = grabEvents2 and grabEvents2:FindFirstChild("CreateGrabLine") or nil
    tbl23.dgl             = grabEvents2 and grabEvents2:FindFirstChild("DestroyGrabLine") or nil
    tbl23.Struggle        = characterEvents and characterEvents:FindFirstChild("Struggle") or nil
    tbl23.RagdollRemote   = characterEvents and characterEvents:FindFirstChild("RagdollRemote") or nil
    tbl23.spe             = playerEvents and playerEvents:FindFirstChild("StickyPartEvent") or nil
    tbl23.spawnEvent      = menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction") or nil
    tbl23.destroyToyEvent = menuToys and menuToys:FindFirstChild("DestroyToy") or nil
    return v21
end
refreshRemotes()

local function fireRemote(arg, ...)
    if not arg then return false, nil end
    local ok2, result2 = pcall(function(...)
        if arg:IsA("RemoteFunction") then return arg:InvokeServer(...) end
        arg:FireServer(...); return true
    end, ...)
    return ok2, result2
end

local tbl17 = {}

tbl17.charp = function(arg)
    local character = arg or localPlayer
    character = character and character.Character
    if not character then return nil,nil,nil end
    return character,
        character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"),
        character:FindFirstChildWhichIsA("Humanoid")
end

tbl17.getMagnitude = function(a,b)
    if not a or not b or not a:IsA("BasePart") or not b:IsA("BasePart") then return math.huge end
    return (a.Position - b.Position).Magnitude
end

tbl17.isnetworkowner = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("BasePart") then return false end
    local root = arg.Massless and arg.AssemblyRootPart or arg
    if not root or root.Anchored then return false end
    if type(isnetworkowner) == "function" then
        local ok2, result2 = pcall(isnetworkowner, root)
        if ok2 and type(result2) == "boolean" then return result2 end
    end
    local ok2, result2 = pcall(function() return root.ReceiveAge end)
    return ok2 and result2 == 0
end

tbl17.ispartowner = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("BasePart") then return false end
    if arg.Name == "HumanoidRootPart" then
        local parent = arg.Parent
        if parent then
            local head_ = parent:FindFirstChild("Head")
            if head_ then
                local po = head_:FindFirstChild("PartOwner")
                if po then return po.Value == localPlayer.Name end
            end
        end
    end
    local po = arg:FindFirstChild("PartOwner")
    if po and po.Value == localPlayer.Name then return true end
    local parent = arg.Parent
    if not parent then return false end
    local po2 = parent:FindFirstChild("PartOwner", true)
    if not po2 then return false end
    return po2.Value == localPlayer.Name
end

tbl17.resetVelocity = function(arg)
    if arg and arg:IsA("BasePart") then
        arg.AssemblyLinearVelocity = Vector3.zero
        arg.AssemblyAngularVelocity = Vector3.zero
    end
end

tbl17.teleport = function(arg, dest, offset)
    if not arg then return false end
    if typeof(arg) == "Instance" and arg:IsA("Model") then
        arg = arg.PrimaryPart or arg:FindFirstChildWhichIsA("BasePart", true)
    end
    if typeof(arg) ~= "Instance" or not arg:IsA("BasePart") then return false end
    local cf
    if typeof(dest) == "CFrame" then cf = dest
    elseif typeof(dest) == "Vector3" then cf = CFrame.new(dest)
    elseif typeof(dest) == "Instance" then
        if dest:IsA("BasePart") then cf = dest.CFrame
        elseif dest:IsA("Model") then cf = dest:GetPivot() end
    end
    if not cf then return false end
    if typeof(offset) == "CFrame" then cf *= offset end
    arg.CFrame = cf
    tbl17.resetVelocity(arg)
    return true
end

tbl17.FormatPlayer = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("Player") then return tostring(arg) end
    if arg == localPlayer then return "You" end
    if arg.DisplayName == arg.Name then return arg.Name end
    return string.format("%s (@%s)", arg.DisplayName, arg.Name)
end

tbl17.findNicePart = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("Model") then return nil end
    local cached = tbl20.GrabbableParts[arg]
    if cached then
        if cached.Parent and cached:IsA("BasePart") and cached.CanQuery and cached.Name ~= "Button" then
            return cached
        end
        tbl20.GrabbableParts[arg] = nil
    end
    for _, ch in pairs(arg:GetChildren()) do
        if ch:IsA("BasePart") and ch.CanQuery and ch.Name ~= "Button" then
            tbl20.GrabbableParts[arg] = ch
            return ch
        end
    end
    return nil
end

tbl17.getInventory = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("Player") then return nil, nil end
    local inv = Workspace:FindFirstChild(arg.Name .. "SpawnedInToys")
    local plots = Workspace:FindFirstChild("Plots")
    local plotItems = Workspace:FindFirstChild("PlotItems")
    local plot = nil
    if plots and plotItems then
        for _, child in pairs(plots:GetChildren()) do
            local sign = child:FindFirstChild("PlotSign")
            sign = sign and sign:FindFirstChild("ThisPlotsOwners")
            if sign then
                for _, v in pairs(sign:GetChildren()) do
                    if v:IsA("StringValue") and v.Value == arg.Name then
                        plot = plotItems:FindFirstChild(child.Name)
                    end
                end
            end
        end
    end
    return inv, plot
end

tbl17.sno = function(arg, _)
    if typeof(arg) ~= "Instance" or not arg:IsA("BasePart") or not arg.Parent then return false end
    local char, hrp, hum = tbl17.charp()
    local head = char and char:FindFirstChild("Head")
    local rag  = hum and hum:FindFirstChild("Ragdolled")
    if not char or not head or not hrp or not hum or not rag or hum.Health <= 0 then return false end
    local spawn = Workspace:FindFirstChild("SpawnLocation")
    if not spawn or tbl17.getMagnitude(arg, spawn) > 1e7 then return false end
    if tbl17.ispartowner(arg) then return true end
    return true
end

tbl17.unsno = function(arg)
    if not arg then return false end
    refreshRemotes()
    if tbl23.dgl then return (fireRemote(tbl23.dgl, arg)) end
    return false
end

tbl17.grab = function(arg, cframe)
    local _, hrp, hum = tbl17.charp()
    if not hrp or not hum or hum.Health == 0 then return end
    if not arg or not arg.Parent or not arg:IsA("BasePart") then return end
    refreshRemotes()
    if not tbl23.sno then return end
    cframe = cframe or hrp.CFrame
    if typeof(cframe) ~= "CFrame" then return end
    local pos = arg.Position
    local look = CFrame.new((cframe * CFrame.new(0, 1.593, 0)).Position, pos)
    tbl23.sno:FireServer(arg, look)
end

tbl17.ragdoll = function(arg)
    if typeof(arg) ~= "Instance" then return end
    local torso, hum
    if arg:IsA("Player") then
        local c = arg.Character
        torso = c and c:FindFirstChild("Torso")
        hum   = c and c:FindFirstChild("Humanoid")
    elseif arg:IsA("Model") then
        torso = arg:FindFirstChild("Torso")
        hum   = arg:FindFirstChild("Humanoid")
        if not arg:FindFirstChild("Head") then return end
    elseif arg:IsA("BasePart") then
        if arg.Parent and arg.Parent:IsA("Model") then
            hum = arg.Parent:FindFirstChild("Humanoid"); torso = arg
        else torso = arg end
    else return end
    if not torso or not torso:IsA("BasePart") or not torso.Parent or not hum then return end
    local rag = hum:FindFirstChild("Ragdolled")
    if not rag or rag.Value ~= false then return end
    if tbl20.States.Ragdolling then return end
    torso.CanCollide = false
    tbl20.States.Ragdolling = true
    local inv = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    if not inv then tbl20.States.Ragdolling=false return end
    local rsc = inv:FindFirstChild("RagdollRSC") or tbl17.st("PalletLightBrown")
    if not rsc then tbl20.States.Ragdolling=false return end
    local sp = rsc:WaitForChild("SoundPart", 0.5)
    if not sp or not sp:IsA("BasePart") then tbl20.States.Ragdolling=false tbl17.dt(rsc) return end
